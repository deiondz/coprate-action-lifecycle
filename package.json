{
  "name": "corporate-action-lifecycle-monitor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:api": "bun --watch apps/api/src/index.ts",
    "start:api": "bun apps/api/src/index.ts",
    "build": "next build",
    "start": "next start",
    "test": "bun test apps/api",
    "env:validate": "bun env.config.ts",
    "env:preview": "envin dev --config env.config.ts --port 3001",
    "lint": "biome check",
    "format": "biome format --write",
    "doctor": "npx react-doctor@latest",
    "profile:announcements": "bun apps/api/scripts/profile-announcement-exports.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@envin/cli": "^1.2.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.1.1",
    "@types/opentype.js": "1.3.10",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@better-auth-ui/core": "1.6.27",
    "@better-auth-ui/react": "1.6.27",
    "@better-auth/mongo-adapter": "1.6.23",
    "@better-auth/passkey": "1.6.23",
    "@neondatabase/serverless": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@scalar/hono-api-reference": "0.12.1",
    "@tanstack/react-pacer": "^0.22.1",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "better-auth": "1.6.23",
    "bowser": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drishti-sdk": "1.0.15",
    "drizzle-orm": "^0.45.2",
    "envin": "^1.2.0",
    "hono": "4.13.7",
    "mongodb": "^7.5.0",
    "mongoose": "8.24.4",
    "motion": "^12.42.2",
    "next": "^16.2.10",
    "next-themes": "^0.4.6",
    "openai": "^7.15.0",
    "opentype.js": "2.0.0",
    "radix-ui": "^1.6.2",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "zod": "^4.4.3"
  }
}
